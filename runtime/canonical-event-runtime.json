{
  "runtime_id": "synal-ec2-standard-v4",
  "role": ["MICRO_INGRESS", "STANDARD_EXECUTOR", "ESTATE_EVENT_CONTINUITY_SENTINEL", "BOUNDED_OPERABILITY_AUDITOR_ROUTER"],
  "canonical_for": ["WKR-EVENT-SENTRY-001", "WKR-SWEEP-001 bounded deterministic operability audit/routing", "WKR-RECOVER-001 continuity handoff"],
  "source_repo": "TML-4PM/synal-core",
  "entrypoint": "uvicorn synal.webhook_listener:app --host 0.0.0.0 --port 8000",
  "service": "t4h-synal-event.service",
  "state_store": "~/.local/state/synal/work.db",
  "auth": "GitHub HMAC-SHA256 required",
  "dedupe": "work_claims.work_key",
  "ledger": "work_ledger",
  "telemetry": "telemetry",
  "proof_store": "proof_runs",
  "sweep_v4": {
    "worker": "WKR-SWEEP-001",
    "mode": "DETERMINISTIC_BOUNDED_AUDIT",
    "default_max_items": 25,
    "source_item_first": true,
    "llm_required": false,
    "max_specialist_handoffs_per_cycle": 1,
    "handoff_dedupe": "source issue + target worker marker",
    "handoff_provider_readback_required": true,
    "continuous_scan_prohibited": true,
    "completion_ownership_retained": false,
    "qualification": "two independent bounded cycles + real specialist handoff + duplicate replay suppression + separate durable proof verifier"
  },
  "github_hosted_compute_required": false,
  "status_rule": "A COMPLETED comment alone is not REAL; transition proof and readback must verify"
}
