{
  "runtime_id": "synal-ec2-standard-v3",
  "role": ["MICRO_INGRESS", "STANDARD_EXECUTOR", "ESTATE_EVENT_CONTINUITY_SENTINEL"],
  "canonical_for": [
    "WKR-EVENT-SENTRY-001",
    "WKR-RECOVER-001 continuity handoff",
    "event-path acceptance",
    "missing receipt/readback detection",
    "stalled or expired event claims",
    "webhook/HMAC/configuration drift",
    "event-driven work stranded by unavailable GitHub-hosted Actions"
  ],
  "source_repo": "TML-4PM/synal-core",
  "entrypoint": "uvicorn synal.webhook_listener:app --host 0.0.0.0 --port 8000",
  "service": "t4h-synal-event.service",
  "persistence": "systemd enabled; durable SQLite state survives worker/model/process context",
  "state_store": "~/.local/state/synal/work.db",
  "auth": "GitHub HMAC-SHA256 required",
  "dedupe": "work_claims.work_key",
  "ledger": "work_ledger",
  "telemetry": "telemetry",
  "proof_store": "proof_runs",
  "process_proof": {
    "required_event_chain": ["RECEIVED", "SIGNATURE_VERIFIED", "CLAIMED", "EXECUTE_START", "VALIDATED", "COMPLETED"],
    "required_ledger_chain": ["CLAIMED", "EXECUTE_START", "VALIDATED", "SLEEP"],
    "digest": "SHA-256 over durable claim/events/ledger/telemetry bundle",
    "independent_readback_endpoint": "/runtime/proof/{work_key}"
  },
  "sentry_default_routing": "event-continuity symptoms route to WKR-EVENT-SENTRY-001 unless an explicit target_worker is supplied",
  "recovery_worker": "WKR-RECOVER-001",
  "github_hosted_compute_required": false,
  "evidence_surface": "GitHub receipt + durable transition proof bundle + proof digest + SQLite ledger/telemetry",
  "status_rule": "A COMPLETED comment alone is not REAL; transition proof and readback must verify"
}
